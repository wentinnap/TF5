# ---- ฐานข้อมูล (จาก Supabase > Project Settings > Database) ----
# ใช้ "Connection pooling" string สำหรับ DATABASE_URL (พอร์ต 6543)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
# ใช้ "Direct connection" string สำหรับ DIRECT_URL (พอร์ต 5432) — Prisma ต้องใช้ตอน migrate
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# ---- ข้อมูลราคา Forex (สมัครฟรีที่ https://twelvedata.com) ----
TWELVE_DATA_API_KEY="your_twelve_data_key"

# ---- ส่งอีเมลแจ้งเตือน (สมัครฟรีที่ https://resend.com) ----
RESEND_API_KEY="your_resend_key"
ALERT_EMAIL_FROM="alerts@yourdomain.com"
ALERT_EMAIL_TO="you@example.com"

# ---- ป้องกันคนภายนอกยิง API สแกน/มอนิเตอร์เล่น ----
CRON_SECRET="สุ่มตัวอักษรยาวๆ_ที่เดายาก"

# ---- คู่เงินที่จะสแกน (คั่นด้วย comma) ----
FOREX_SYMBOLS="EUR/USD,GBP/USD,USD/JPY,AUD/USD"

# ---- Time frame ที่ใช้วิเคราะห์ ----
# ตัวเลือกของ Twelve Data: 1h, 4h, 1day, 1week
# TF ยาว (แนะนำ): "1day" — เทรนด์ชัด สัญญาณน้อยแต่แม่นกว่า เหมาะกับ swing/position trade
FOREX_INTERVAL="1day"
# จำนวนแท่งย้อนหลังที่ดึงมา ต้องพอสำหรับ EMA200 (ควร >= 300)
FOREX_OUTPUTSIZE="400"

# ---- จำกัดจำนวน signal ต่อวัน ----
MAX_SIGNALS_PER_DAY="2"
